    { "source": "/blog(.*)", "destination": "/", "permanent": true },
    { "source": "/process(.*)", "destination": "/", "permanent": true },
    { "source": "/about(.*)", "destination": "/", "permanent": true },
    { "source": "/industry-maps(.*)", "destination": "/", "permanent": true },
